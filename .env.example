# Local-only secrets — this file is gitignored (.gitignore lists .env). NEVER commit real keys.
# Copy to `.env` in the repo root and fill in:
#   Copy-Item .env.example .env

# Chat analyst (Ask) — Groq key. Get one free at:
# https://console.groq.com/keys (no credit card; generous free tier)
GROQ_API_KEY=

# Optional overrides (defaults: Groq endpoint + openai/gpt-oss-120b reasoning):
# ASSISTANT_ENDPOINT=https://api.groq.com/openai/v1/chat/completions
# ASSISTANT_MODEL=openai/gpt-oss-120b

# Optional: frontend origins allowed by CORS (comma-separated)
# FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
